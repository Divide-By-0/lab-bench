{
  "context_version": "1.0",
  "human_cell_model": "differentiated HepaRG hepatocyte-like cells",
  "system_size": {
    "final_plasmids": 3,
    "each_plasmid_must_have_an_independent_fluorescent_readout": true
  },
  "shared_input": {
    "inducer": "doxycycline",
    "test_range_ng_per_ml": [0, 0.1, 1, 10, 100, 1000]
  },
  "promoter_matching_rule": {
    "architectures_must_be_nonidentical": true,
    "maximum_ratio_of_largest_to_smallest_EC50": 10.0,
    "maximum_ratio_of_largest_to_smallest_saturating_output": 10.0,
    "evidence_requirement": "Use quantitative public evidence where available; identify rather than invent any evidence gap."
  },
  "flow_cytometer": {
    "lasers_nm": [405, 488, 561, 640],
    "detector_windows_nm": [
      {"name": "V450", "center": 450, "width": 50},
      {"name": "B530", "center": 530, "width": 30},
      {"name": "YG586", "center": 586, "width": 15},
      {"name": "R670", "center": 670, "width": 30}
    ],
    "reporter_rule": "Assign each reporter to a different detector and evaluate excitation, emission, and spillover using public spectral data."
  },
  "starting_sequence_inventory": "none",
  "allowed_plasmid_construction_methods": [
    "Gibson assembly",
    "Golden Gate assembly",
    "restriction-enzyme assembly"
  ]
}
